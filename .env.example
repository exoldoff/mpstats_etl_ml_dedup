# MPStats local app / research environment example.
# Copy to .env only for local development. Never commit real cookies, tokens,
# passwords, private file paths, or customer data.

# Optional app runtime paths. Defaults are suitable for local launcher usage.
# MPSTATS_APP_PORT=8055
# MPSTATS_DB_PATH=mpstats.duckdb
# MPSTATS_WORKDIR=pipeline
# MPSTATS_STATIC_DIR=web/dist

# Optional research/model settings.
# POLZA_API_KEY=
# POLZA_BASE_URL=https://polza.ai/api/v1
# HF_TOKEN=
DEDUP_MODEL_CACHE_DIR=research/dedup/models
DEDUP_MODEL_LOCAL_ONLY=0

# Optional Telegram labeling bot settings. Keep real values only in local .env.
# DEDUP_TELEGRAM_BOT_TOKEN=
# DEDUP_TELEGRAM_ACCESS_PASSWORD=
# DEDUP_TELEGRAM_ADMIN_USER_IDS=
